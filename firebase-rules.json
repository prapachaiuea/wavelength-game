{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".write": "auth != null && !newData.exists() && data.child('public/createdAt').exists() && now > data.child('public/createdAt').val() + 86400000",
        "public": {
          ".read": "auth != null",
          "host": {
            ".write": "auth != null && (!data.exists() || auth.uid === data.val())"
          },
          "createdAt": {
            ".write": "auth != null && !data.exists()"
          },
          "roundNumber": {
            ".write": "auth != null && auth.uid === root.child('rooms').child($roomId).child('public/host').val()"
          },
          "roundDurationMs": {
            ".write": "auth != null && auth.uid === root.child('rooms').child($roomId).child('public/host').val()"
          },
          "timer": {
            ".write": "auth != null && auth.uid === root.child('rooms').child($roomId).child('public/host').val()"
          },
          "guess": {
            ".write": "auth != null && (auth.uid === root.child('rooms').child($roomId).child('public/host').val() || (root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && root.child('rooms').child($roomId).child('public/phase').val() === 'guessing'))"
          },
          "phase": {
            ".write": "auth != null && (auth.uid === root.child('rooms').child($roomId).child('public/host').val() || (root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && data.val() === 'guessing' && newData.val() === 'voting') || (root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && data.val() === 'guessing' && newData.val() === 'results' && now >= root.child('rooms').child($roomId).child('public/timer/startAt').val() + root.child('rooms').child($roomId).child('public/timer/durationMs').val()))"
          }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('rooms').child($roomId).child('public/phase').val() === 'lobby')"
          }
        },
        "secrets": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('rooms').child($roomId).child('public/host').val())",
            ".write": "auth != null && auth.uid === root.child('rooms').child($roomId).child('public/host').val()"
          }
        },
        "reveal": {
          "insiderUid": {
            ".read": "auth != null && (auth.uid === root.child('rooms').child($roomId).child('public/host').val() || (root.child('rooms').child($roomId).child('public/phase').val() === 'results' && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()))",
            ".write": "auth != null && auth.uid === root.child('rooms').child($roomId).child('public/host').val()"
          }
        },
        "votes": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('rooms').child($roomId).child('public/host').val() || root.child('rooms').child($roomId).child('public/phase').val() === 'results')",
            ".write": "auth != null && (auth.uid === root.child('rooms').child($roomId).child('public/host').val() || (auth.uid === $uid && root.child('rooms').child($roomId).child('public/phase').val() === 'voting' && root.child('rooms').child($roomId).child('secrets').child(auth.uid).child('role').val() !== 'master' && newData.child('votedFor').exists() && root.child('rooms').child($roomId).child('players').child(newData.child('votedFor').val()).exists()))"
          }
        }
      }
    },
    "wavelength": {
      "$roomId": {
        ".write": "auth != null && !newData.exists() && data.child('public/createdAt').exists() && now > data.child('public/createdAt').val() + 86400000",
        "public": {
          ".read": "auth != null",
          "host": {
            ".write": "auth != null && (!data.exists() || auth.uid === data.val())"
          },
          "createdAt": {
            ".write": "auth != null && !data.exists()"
          },
          "totalRounds": {
            ".write": "auth != null && auth.uid === root.child('wavelength').child($roomId).child('public/host').val()"
          },
          "roundNumber": {
            ".write": "auth != null && auth.uid === root.child('wavelength').child($roomId).child('public/host').val()"
          },
          "clueGiverOrder": {
            ".write": "auth != null && auth.uid === root.child('wavelength').child($roomId).child('public/host').val()"
          },
          "clueGiverUid": {
            ".write": "auth != null && auth.uid === root.child('wavelength').child($roomId).child('public/host').val()"
          },
          "mode": {
            ".write": "auth != null && auth.uid === root.child('wavelength').child($roomId).child('public/host').val()"
          },
          "spectrumId": {
            ".write": "auth != null && auth.uid === root.child('wavelength').child($roomId).child('public/host').val()"
          },
          "clue": {
            ".write": "auth != null && (auth.uid === root.child('wavelength').child($roomId).child('public/host').val() || (auth.uid === root.child('wavelength').child($roomId).child('public/clueGiverUid').val() && root.child('wavelength').child($roomId).child('public/phase').val() === 'clue-reveal'))"
          },
          "pointer": {
            ".write": "auth != null && (auth.uid === root.child('wavelength').child($roomId).child('public/host').val() || (root.child('wavelength').child($roomId).child('players').child(auth.uid).exists() && auth.uid !== root.child('wavelength').child($roomId).child('public/clueGiverUid').val() && root.child('wavelength').child($roomId).child('public/phase').val() === 'guessing'))"
          },
          "phase": {
            ".write": "auth != null && (auth.uid === root.child('wavelength').child($roomId).child('public/host').val() || (auth.uid === root.child('wavelength').child($roomId).child('public/clueGiverUid').val() && data.val() === 'clue-reveal' && newData.val() === 'guessing' && root.child('wavelength').child($roomId).child('public/clue').exists()) || (auth.uid === root.child('wavelength').child($roomId).child('public/clueGiverUid').val() && data.val() === 'guessing' && newData.val() === 'round-reveal' && (root.child('wavelength').child($roomId).child('public/mode').val() === 'competitive' || root.child('wavelength').child($roomId).child('public/pointer/locked').val() === true)))"
          }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('wavelength').child($roomId).child('public/phase').val() === 'lobby')"
          }
        },
        "guesses": {
          "$uid": {
            "locked": {
              ".read": "auth != null && root.child('wavelength').child($roomId).child('players').child(auth.uid).exists()"
            },
            "position": {
              ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('wavelength').child($roomId).child('public/host').val() || auth.uid === root.child('wavelength').child($roomId).child('public/clueGiverUid').val() || root.child('wavelength').child($roomId).child('public/phase').val() === 'round-reveal')"
            },
            ".write": "auth != null && (auth.uid === root.child('wavelength').child($roomId).child('public/host').val() || (auth.uid === $uid && auth.uid !== root.child('wavelength').child($roomId).child('public/clueGiverUid').val() && root.child('wavelength').child($roomId).child('public/phase').val() === 'guessing' && root.child('wavelength').child($roomId).child('public/mode').val() === 'competitive'))"
          }
        },
        "secrets": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('wavelength').child($roomId).child('public/host').val())",
            ".write": "auth != null && auth.uid === root.child('wavelength').child($roomId).child('public/host').val()"
          }
        },
        "rounds": {
          ".read": "auth != null && root.child('wavelength').child($roomId).child('players').child(auth.uid).exists()",
          "$roundNumber": {
            ".write": "auth != null && (auth.uid === root.child('wavelength').child($roomId).child('public/host').val() || (auth.uid === root.child('wavelength').child($roomId).child('public/clueGiverUid').val() && root.child('wavelength').child($roomId).child('public/phase').val() === 'guessing' && (root.child('wavelength').child($roomId).child('public/mode').val() === 'competitive' || root.child('wavelength').child($roomId).child('public/pointer/locked').val() === true)))"
          }
        }
      }
    }
  }
}
